{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "paste-voila-dev",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"routes": [
		{ "pattern": "paste.voila.dev", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "paste-voila",
			"database_id": "118a3c92-053c-4b81-887d-cecec2ef9cb2",
			"migrations_dir": "../../packages/architecture/src/repositories/drizzle/migrations"
		}
	],
	"unsafe": {
		"bindings": [
			{
				"name": "CREATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": { "limit": 5, "period": 60 }
			},
			{
				"name": "UPDATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1002",
				"simple": { "limit": 20, "period": 60 }
			}
		]
	},
	"observability": {
		"enabled": true
	}
}
